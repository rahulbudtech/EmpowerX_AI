
# --- LLM (Gemini primary) ---
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash
GEMINI_API_KEY=your_gemini_api_key_here
# GOOGLE_API_KEY=  # optional alias if you prefer this name

# --- Fallback LLM (reserved — not wired yet) ---
# LLM_FALLBACK_PROVIDER=
# LLM_FALLBACK_MODEL=

# --- Postgres (local) ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/empowerx

# --- Redis / Celery ---
REDIS_URL=redis://127.0.0.1:6379/0
# CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
UPLOAD_DIR=uploads
PREPROCESS_IMAGE_DIR=preprocessed
MAX_DICOM_FILES_PER_REQUEST=3
MAX_DICOM_FILE_SIZE_MB=10
