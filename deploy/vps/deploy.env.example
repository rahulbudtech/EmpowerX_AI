# Non-secret paths written to /etc/empowerx-ai/deploy.env by the installer.
# Do not put DATABASE_URL, API keys, or passwords in this file.
EMPOWERX_AI_LIVE_DIR=/var/www/empowerx/EmpowerX-AI
EMPOWERX_AI_STATE_DIR=/var/lib/empowerx-ai
EMPOWERX_AI_PYTHON=/opt/empowerx-ai/python/cpython-3.12-linux-x86_64-gnu/bin/python3.12
EMPOWERX_AI_UV=/usr/local/bin/uv
EMPOWERX_AI_HEALTH_URL=http://127.0.0.1:8002/health
EMPOWERX_AI_PUBLIC_HEALTH_URL=https://ai.devempowerx.io/health
EMPOWERX_AI_REQUIRE_PUBLIC_HEALTH=yes
EMPOWERX_AI_API_PM2=empowerx-ai-api
EMPOWERX_AI_WORKER_PM2=empowerx-ai-worker
EMPOWERX_AI_BASELINE_SHA=8238ab968840be4530458e7cabfc508391906dc4
EMPOWERX_AI_MIN_FREE_KB=1048576
EMPOWERX_AI_PG_DUMP=/usr/bin/pg_dump
EMPOWERX_AI_ECOSYSTEM=/etc/empowerx-ai/ecosystem.config.cjs
