#!/bin/bash
# Root helper for one forward Alembic upgrade. No downgrade path.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck disable=SC1091
source "$ROOT/lib/common.sh"

apply_security_posture
load_config

[[ "${1:-}" == "apply" ]] || die 2 "usage: empowerx-ai-migrate apply SHA"
assert_sha "${2:-}" || die 2 "invalid commit sha"
sha="$2"

if [[ "${EMPOWERX_AI_TEST_MODE:-}" == "1" ]] && ! production_mode; then
  mkdir -p "$EMPOWERX_AI_STATE_DIR/stub-runtime"
  printf 'apply %s\n' "$sha" >> "$EMPOWERX_AI_STATE_DIR/stub-runtime/calls"
  if [[ -f "$EMPOWERX_AI_STATE_DIR/stub-runtime/migrate.exit" ]]; then
    rc="$(tr -d '[:space:]' < "$EMPOWERX_AI_STATE_DIR/stub-runtime/migrate.exit")"
    log "test mode recorded failed migration apply for $sha"
    exit "$rc"
  fi
  log "applied pending forward migrations for $sha"
  exit 0
fi

release="$EMPOWERX_AI_STATE_DIR/releases/$sha"
py="$release/.venv/bin/python"
[[ -x "$py" ]] || die 6 "release interpreter is missing"
set +e
out="$(runuser -u empowerx-ai -- "$py" "$ROOT/lib/migration_status.py" check \
  --release "$release" \
  --env-file "$EMPOWERX_AI_LIVE_DIR/.env" 2>&1)"
rc=$?
set -e
printf '%s\n' "$out" | redact_stream >&2
if [[ "$rc" -eq 0 ]]; then
  log "already at alembic head; skipping migrations"
  exit 0
fi
[[ "$rc" -eq 10 ]] || die 6 "migration execution failed"
head_line="$(printf '%s\n' "$out" | awk -F= '/^head=/{print $2; exit}')"
assert_revision "$head_line" || die 6 "migration head is malformed"

work="$(mktemp -d /tmp/empowerx-ai-mig.XXXXXX)"
chown empowerx-ai:empowerx-ai "$work"
chmod 700 "$work"
stamp="$(date -u +%Y%m%dT%H%M%SZ)"
if ! runuser -u empowerx-ai -- env EMPOWERX_AI_PG_DUMP="${EMPOWERX_AI_PG_DUMP:-pg_dump}" \
  "$py" "$ROOT/lib/migration_status.py" upgrade \
  --release "$release" \
  --env-file "$EMPOWERX_AI_LIVE_DIR/.env" \
  --backup "$work/ai-tables.dump" \
  --expect-head "$head_line"; then
  rm -rf "$work"
  die 6 "migration execution failed"
fi
mkdir -p "$EMPOWERX_AI_STATE_DIR/backups/migrations"
install -m 600 -o root -g root "$work/ai-tables.dump" \
  "$EMPOWERX_AI_STATE_DIR/backups/migrations/${stamp}-${head_line}.dump"
rm -rf "$work"
log "applied pending forward migrations $head_line"
